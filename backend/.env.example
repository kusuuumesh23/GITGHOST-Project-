# ==============================================================================
# PostDaily Backend Environment Configuration
# ==============================================================================

# Server & Runtime
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postdaily?schema=public

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-string
JWT_EXPIRES_IN=7d

# TinyFish Website Crawling API
# Sign up at https://tinyfish.ai to get an API key
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_TIMEOUT_MS=60000

# NVIDIA NIM / DeepSeek Text Generation
# Generate an API key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-r1
NVIDIA_NIM_TIMEOUT_MS=45000

# Image Generation & Asset Storage
# Storage mode: local | s3
IMAGE_STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads/assets
# Optional Image Generation Provider: mock | stability | openai | custom
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CRAWL_RATE_LIMIT_MAX=10
GENERATION_RATE_LIMIT_MAX=20

# Social OAuth 2.0 & Token Encryption
REDIRECT_BASE_URL=http://localhost:5001
# 32-byte (64 hex characters) AES-256 encryption key for OAuth tokens
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LinkedIn Developer App (OAuth 2.0)
# Scopes needed: openid, profile, w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X (Twitter) Developer App (OAuth 2.0 + PKCE)
# Scopes needed: tweet.read, tweet.write, users.read, offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
